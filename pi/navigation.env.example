# Copy to navigation.env on the Pi; chmod 600 navigation.env.
# Read on each request; no restart required after changing keys.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GOOGLE_MAPS_API_KEY=
# Public browser key: restrict to the dashboard's HTTP referrers and Maps JavaScript API.
GOOGLE_MAPS_BROWSER_KEY=
